FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY setup.py setup.cfg ./
COPY src ./src
COPY api ./api
RUN pip install -e .

CMD ["bash", "-lc", "reranker train --embeddings-path /app/results/article_embeddings.parquet --feedback-path /app/data/article_feedback.csv --output-dir /app/artefacts --test-size 0.2 --n-negatives 3 --score"]

